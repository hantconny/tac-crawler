DB_URL=postgresql://crawler:secret@192.168.185.83:5432/sns_crawler
REDIS_URL=redis://192.168.185.83:6379/0
LOG_LEVEL=INFO
CRAWLER_CONFIG_DIR=D:/ENV/Workspace/pycharm/sns-crawlers/config/crawlers
OUTPUT_DIR=D:/ENV/Workspace/pycharm/sns-crawlers/output
# 开发时使用 clash 提供全局代理
# 部署时 mihomo 开启 tun 模式提供全局代理，docker 容器内也可以翻墙
# 仅暗网 worker 需要配置 CHROME_PROXY
# 仅在开发时配置 --host-resolver-rules=MAP * ~NOTFOUND , EXCLUDE 127.0.0.1
# 仅在开发时使用 9150 端口，容器化部署时依然是 9050 端口，且容器化部署时不依赖此文件中的该变量，使用 docker-compose.yml 中的配置
#CHROME_PROXY=socks5://127.0.0.1:9150|--host-resolver-rules=MAP * ~NOTFOUND , EXCLUDE 127.0.0.1
# 本地开发需配置，容器化部署时由 Dockerfile 在构建镜像时设置为 ENV
CHROME_BINARY=D:/ENV/chromedriver/chrome-win64/chrome.exe
CHROMEDRIVER_PATH=D:/ENV/chromedriver/chromedriver.exe
SINGLEFILE_BINARY=D:/ENV/single-file.exe
# 本地开发需要配置，容器化部署时由 docker-compose.yml 注入
# 仅在需要使用 singlefile/trafilatura 的容器需要在 chrome option 中加入 --disable-web-security
# 其他容器不开启，容易被 cloudfront 等 WAF 误判为非安全环境导致返回 401
#CHROME_DISABLE_WEB_SECURITY="1"
# 本地开发需要配置，容器化部署时由 docker-compose.yml 注入
WORKER_INSTANCE=snapchat-worker-1
# 本地开发需要配置，容器化部署时应在 env.docker 中配置 TG_API_ID_n，TG_API_HASH_n
# 对应手机号：+8615951993422
TELEGRAM_API_ID=25219374
TELEGRAM_API_HASH=2bd63e562f7342df8cbc50db505cd1fa
# 本地开发需要配置，容器化部署时通过 telegram-sessions volume 持久化
TELEGRAM_SESSION_DIR=D:/ENV/Workspace/pycharm/sns-crawlers/telegram-sessions
# 本地开发需要配置，容器化部署时应在 env.docker 中配置 YOUTUBE_API_KEY_n
YOUTUBE_API_KEY=AIzaSyAHWnv30JNmrGmNqtSp8RnMfdoa4314bmc
